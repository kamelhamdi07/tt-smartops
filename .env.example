# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.

# --- Base Neon (utiliser l'URL "direct", non poolée, pour Flyway) ---
DB_URL=jdbc:postgresql://ep-xxxxx.eu-central-1.aws.neon.tech/smartops?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# --- JWT : clé Base64 d'au moins 256 bits ---
# Générer : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- CORS : origine du frontend en développement (ng serve) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Horaires de travail utilisés pour la disponibilité ---
WORK_START=08:00
WORK_END=17:00

# --- Premier compte ADMIN (créé seulement si aucun ADMIN n'existe) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Données de démonstration (6 comptes : RH, responsable, 3 techniciens, 1 employé) ---
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=
